        {
          "name": "Get ORDS OAuth Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token request returns 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Token response is JSON\", function () {\r\n    pm.response.to.be.json;\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Access token is returned\", function () {\r\n    pm.expect(response).to.have.property(\"access_token\");\r\n    pm.expect(response.access_token).to.be.a(\"string\");\r\n    pm.expect(response.access_token).not.to.be.empty;\r\n});\r\n\r\nif (response.access_token) {\r\n    pm.environment.set(\"access_token\", response.access_token);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "url": {
              "raw": "{{ords_schema_url}}/oauth/token",
              "host": [
                "{{ords_schema_url}}"
              ],
              "path": [
                "oauth",
                "token"
              ]
            }
          },
          "response": []
        }
